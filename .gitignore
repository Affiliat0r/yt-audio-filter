# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
# NOTE: the build-artifact dirs above are anchored to the repo root on purpose.
# Unanchored `lib/` would also swallow `web/lib/`, which is application source.
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Environments
.env
.venv
env/
venv/
ENV/

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Temp files from this tool
yt_audio_filter_*/

# Output files (optional - remove if you want to track outputs)
*_filtered.mp4

# OS files
.DS_Store
Thumbs.db

# Sensitive files
client_secrets.json
request.token
*.token

# Large binary files
ffmpeg-*.tar.xz
ffmpeg-*.zip
ffmpeg-*-essentials_build/
youtubeuploader.exe
youtubeuploader.zip

# Data and output directories (top-level only; src/yt_audio_filter/data/
# is an intentionally-tracked source data dir for reciter manifest etc.)
/data/
output/
input/
pot-provider/

# External binary tool, downloaded via docs/plans/...-design.md setup steps
tools/realesrgan/

# Worker secrets + local job/render bookkeeping
worker/.env
worker/state/

# Node dependencies anywhere in the tree (web/, visuals/, future workspaces).
# Unanchored on purpose — an anchored web/node_modules/ rule already let
# visuals/node_modules slip through once.
node_modules/

# Next.js Studio (web/) — build output and deps
web/.next/
web/out/
web/.vercel/
web/next-env.d.ts
web/tsconfig.tsbuildinfo
# web/.env.local holds APP_PASSWORD / WORKER_TOKEN / Redis creds
web/.env*.local

# Worker daemon local config + job->file sidecar state
worker/.env
worker/state/

# Hidden-worker log (Task Scheduler)
worker/worker.log

# Pipeline working directory: downloaded sources, per-surah audio, concat
# output, Real-ESRGAN upscales, thumbnails, catalog + search caches.
# Regenerates itself on demand and runs to several GB.
/cache/

# Runtime bookkeeping (processed_pairs.json) — machine-local, not source.
/state/

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Scratch notes and one-off helpers kept at the repo root
/IMPLEMENTATION_SUMMARY.md
/QUICK_START_GUI.md
/test_complete_pipeline.bat
/youtube_replacement.txt

# Rendered three.js test output — regenerated by `node visuals/cli.mjs`
/visuals/out/
