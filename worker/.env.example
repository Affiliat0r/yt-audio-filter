# Quran Studio worker configuration.
#
# Copy to worker/.env and fill in. Values already present in the real process
# environment win over this file. worker/.env is gitignored — the token below
# grants write access to your Studio queue.

# --- Required -------------------------------------------------------------

# Base URL of the Vercel deployment, no trailing slash.
STUDIO_BASE_URL=https://your-project.vercel.app

# Shared secret sent as the `x-worker-token` header. Must match the
# WORKER_TOKEN environment variable set on the Vercel project.
WORKER_TOKEN=change-me

# --- Optional -------------------------------------------------------------

# Stable name for THIS machine, sent on every claim so the Studio can pin a
# job to one laptop. Leave blank and the worker derives one from the hostname
# plus a durable machine fingerprint (e.g. `hasan-laptop-3f9c1ab2`) and
# remembers it in worker/state/worker_id.txt, so restarts keep the same id.
# Set it explicitly if you want a name you chose; changing it invalidates any
# job already targeted at the old id.
WORKER_ID=

# Port of the loopback discovery endpoint (http://127.0.0.1:<port>/whoami),
# which is how a Studio tab learns that this worker is the local one. Must
# match DISCOVERY_PORT in web/lib/types.ts (7717) unless you change both.
# Only move it if something else already owns the port — e.g. a second worker
# on the same machine. Disable entirely with `--no-discovery`.
WORKER_DISCOVERY_PORT=7717

# Seconds between claim polls when the queue is empty (default: 5).
WORKER_POLL_SECONDS=5

# Cache directory for downloads, upscales, and renders, relative to the
# working directory the worker is started from (default: cache).
WORKER_CACHE_DIR=cache

# Vercel automation-bypass secret. Only needed when the deployment has
# Deployment Protection enabled (Vercel dashboard -> Settings -> Deployment
# Protection -> Protection Bypass for Automation). Sent as the
# `x-vercel-protection-bypass` header; harmless when protection is off.
VERCEL_AUTOMATION_BYPASS_SECRET=
